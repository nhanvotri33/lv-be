# Mẫu cấu hình - copy file này thành .env rồi điền giá trị thật.
# Quy tắc ánh xạ với appsettings.json: "Section:Key"  <->  Section__Key
# (dấu 2 gạch dưới "__" tương đương dấu ":" trong appsettings.json)
# Giá trị trong .env luôn GHI ĐÈ giá trị trong appsettings.json.

# Connection String  ->  ConnectionStrings:DefaultConnection
ConnectionStrings__DefaultConnection="Server=localhost;Database=csdl_phone;Trusted_Connection=True;TrustServerCertificate=True"

# JWT Settings  ->  Jwt:*
Jwt__Key="YOUR_JWT_KEY_MUST_BE_AT_LEAST_256_BITS_HERE"
Jwt__Issuer="https://localhost:5001"
Jwt__Audience="https://localhost:5001"

# Cloudinary  ->  CloudUpload:*
CloudUpload__CloudName="YOUR_CLOUDINARY_CLOUD_NAME"
CloudUpload__ApiKey="YOUR_CLOUDINARY_API_KEY"
CloudUpload__ApiSecret="YOUR_CLOUDINARY_API_SECRET"

# Email Settings  ->  EmailSettings:*
EmailSettings__Host="smtp.gmail.com"
EmailSettings__Port="587"
EmailSettings__Username="YOUR_GMAIL_USERNAME"
EmailSettings__Password="YOUR_GMAIL_APP_PASSWORD"
EmailSettings__FromEmail="YOUR_GMAIL_FROM_EMAIL"

# Frontend  ->  Frontend:BaseUrl
Frontend__BaseUrl="http://localhost:5173"

# Stripe  ->  Stripe:*
Stripe__SecretKey="sk_test_xxx"
Stripe__PublishableKey="pk_test_xxx"

# VNPay  ->  VnPay:*
VnPay__PaymentUrl="https://sandbox.vnpayment.vn/paymentv2/vpcpay.html"
VnPay__TmnCode="YOUR_VNPAY_TMN_CODE"
VnPay__HashSecret="YOUR_VNPAY_HASH_SECRET"

# Google OAuth  ->  Google:ClientId
Google__ClientId="YOUR_GOOGLE_CLIENT_ID"

# Ahamove  ->  Ahamove:*
Ahamove__ApiKey="YOUR_AHAMOVE_API_KEY"
Ahamove__Mobile="84xxxxxxxxx"
Ahamove__BaseUrl="https://apistg.ahamove.com"
Ahamove__WarehouseAddress="180 Cao Lỗ, Phường 4, Quận 8, Hồ Chí Minh"
Ahamove__WarehouseLat=10.7379415
Ahamove__WarehouseLng=106.6757237

# AI Chatbot  ->  Ai:*
Ai__ApiKey="YOUR_OPENAI_API_KEY"
Ai__BaseUrl="https://api.openai.com/v1"
Ai__Model="gpt-4o-mini"
Ai__TimeoutSeconds=30
