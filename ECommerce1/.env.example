# Connection String
ConnectionStrings__DefaultConnection="Server=YOUR_SERVER;Database=YOUR_DB;Trusted_Connection=True;TrustServerCertificate=True"

# JWT Settings
Jwt__Key="YOUR_JWT_SECRET_KEY"
Jwt__Issuer="https://localhost:5001"
Jwt__Audience="https://localhost:5001"

# Cloudinary
CloudUpload__CloudName="YOUR_CLOUDINARY_NAME"
CloudUpload__ApiKey="YOUR_CLOUDINARY_API_KEY"
CloudUpload__ApiSecret="YOUR_CLOUDINARY_API_SECRET"

# Email Settings
EmailSettings__Host="smtp.gmail.com"
EmailSettings__Port="587"
EmailSettings__Username="YOUR_EMAIL_USERNAME"
EmailSettings__Password="YOUR_EMAIL_APP_PASSWORD"
EmailSettings__FromEmail="YOUR_EMAIL_FROM"

# Stripe
Stripe__SecretKey="YOUR_STRIPE_SECRET_KEY"
Stripe__PublishableKey="YOUR_STRIPE_PUBLISHABLE_KEY"

# Google OAuth
Google__ClientId="YOUR_GOOGLE_CLIENT_ID"

# Ahamove Integration
Ahamove__ApiKey="YOUR_AHAMOVE_API_KEY"
Ahamove__Mobile="YOUR_AHAMOVE_REGISTERED_PHONE"
Ahamove__BaseUrl="https://apistg.ahamove.com"
Ahamove__WarehouseAddress="180 Cao Lỗ, Phường 4, Quận 8, Hồ Chí Minh"
Ahamove__WarehouseLat=10.7379415
Ahamove__WarehouseLng=106.6757237
